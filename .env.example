# Files remain ordinary files below this directory. Do not point this at a mount
# whose identity you have not initialized and recorded.
CLOUD_STORAGE_PATH=./storage

# Development only. In production, set CLOUD_STORAGE_ID to the UUID in
# $CLOUD_STORAGE_PATH/.continental/storage-id and keep this false.
CLOUD_ALLOW_STORAGE_INIT=true
CLOUD_STORAGE_ID=

# Bind loopback by default. Let Caddy expose it only on the Tailscale interface.
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8787

# Required outside development. The web UI sends this as X-Continental-Token.
CLOUD_AUTH_TOKEN=replace-with-a-long-random-value
CLOUD_AUTH_DISABLED=false
CLOUD_ALLOWED_ORIGIN=
CLOUD_MAX_UPLOAD_BYTES=21474836480
CLOUD_UPLOAD_CHUNK_BYTES=8388608
# Keep the newest N overwritten copies per file and purge Trash only through
# the explicit cleanup command (schedule `npm run cleanup` daily in production).
CLOUD_VERSION_RETENTION=25
CLOUD_TRASH_RETENTION_DAYS=30
# New uploads are refused only by the filesystem itself; this reserve is a
# health warning so you can make space before an SMB volume is full.
CLOUD_MIN_FREE_BYTES=1073741824
CLOUD_APP_VERSION=0.1.0
